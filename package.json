{
    "name": "@devxbhuvn/array-fns",
    "version": "1.1.0",
    "description": "Modern, dependency-free TypeScript array utilities for everyday JavaScript and TypeScript development.",
    "license": "MIT",
    "author": "Bhuvanesh C <cjbhuvanesh8@gmail.com>",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/devxbhuvn/array-fns.git"
    },
    "bugs": {
        "url": "https://github.com/devxbhuvn/array-fns/issues"
    },
    "homepage": "https://github.com/devxbhuvn/array-fns#readme",
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        }
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "keywords": [
        "array",
        "collections",
        "utilities",
        "typescript",
        "javascript",
        "immutable",
        "functions",
        "array-fns"
    ],
    "scripts": {
        "build": "tsup src/index.ts --format esm,cjs --dts --clean",
        "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "clean": "rimraf dist",
        "pack:check": "npm pack --dry-run",
        "prepublishOnly": "npm run build"
    },
    "engines": {
        "node": ">=18"
    },
    "sideEffects": false,
    "publishConfig": {
        "access": "public"
    },
    "devDependencies": {
        "@types/node": "^22.13.10",
        "@typescript-eslint/eslint-plugin": "^8.26.1",
        "@typescript-eslint/parser": "^8.26.1",
        "eslint": "^9.22.0",
        "eslint-config-prettier": "^10.1.1",
        "prettier": "^3.5.3",
        "rimraf": "^6.0.1",
        "tsup": "^8.5.1",
        "typescript": "^5.8.2",
        "typescript-eslint": "^8.26.1",
        "vitest": "^3.0.8"
    }
}
